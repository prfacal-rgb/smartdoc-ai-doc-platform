<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-SmartDoc.Worker-2085cdf9-edfe-426b-8587-36c745729f83</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <!-- Same Serilog wiring as SmartDoc.Api (ADR 0020), added explicitly here since this is a
         plain Generic Host, not ASP.NET Core — no Serilog.AspNetCore to pull these in transitively. -->
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartDoc.Application\SmartDoc.Application.csproj" />
    <ProjectReference Include="..\SmartDoc.Infrastructure\SmartDoc.Infrastructure.csproj" />
  </ItemGroup>
</Project>
