# Copiar este archivo a .env y ajustar valores para desarrollo local.
# .env NO debe commitearse (agregar a .gitignore).

# --- PostgreSQL (usado por docker-compose.yml) ---
POSTGRES_USER=smartdoc
POSTGRES_PASSWORD=smartdoc_dev_password
POSTGRES_DB=smartdoc

# --- MinIO (object storage, usado por docker-compose.yml) ---
MINIO_ROOT_USER=smartdoc
MINIO_ROOT_PASSWORD=smartdoc_dev_password
MINIO_BUCKET_NAME=smartdoc-documents

# --- AI Service (Python) ---
AI_SERVICE_PORT=8000
EMBEDDING_PROVIDER=ollama
# Ollama corre en la máquina física, no en esta VM ni en un contenedor — ajustar según la
# red host-only real (ver ADR 0011). 192.168.56.1 es el valor confirmado en esta VM.
OLLAMA_BASE_URL=http://192.168.56.1:11434/v1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Groq para /generate, no Ollama local — /generate es síncrono/user-facing, y Ollama local
# midió 40s+ para una respuesta corta contra ~0.5s de Groq (ver ADR 0014). Requiere cuenta
# en https://console.groq.com/keys (tiene free tier).
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- .NET Api / Worker (usado por docker-compose.yml, ver ADR 0024) ---
# Mismo valor que appsettings.Development.json (ya público en el repo) - no hay nada más
# sensible que proteger acá, es un secreto de dev de una PoC, no de un deploy real.
JWT_SECRET=scufkUN1BDa9dO03GzxzbaiRijT4KR9LxIC4ntoVjRo
JWT_SEED_USER_EMAIL=dev@smartdoc.local
JWT_SEED_USER_PASSWORD=smartdoc_dev_password
API_PORT=8080
WORKER_POLLING_INTERVAL_SECONDS=5
WORKER_MAX_RETRIES=3
RAG_DEFAULT_TOPK=5
RAG_MAX_TOPK=50
# Calibrado empíricamente (ver ADR 0022) - no es un valor de ejemplo, es el que se usa.
RAG_MAX_RELEVANT_DISTANCE=0.33
