# Copiar este archivo a .env y ajustar valores para desarrollo local.
# .env NO debe commitearse (agregar a .gitignore).

# --- PostgreSQL (usado por docker-compose.yml) ---
POSTGRES_USER=smartdoc
POSTGRES_PASSWORD=smartdoc_dev_password
POSTGRES_DB=smartdoc

# --- AI Service (Python) — para cuando se active en el compose ---
AI_SERVICE_PORT=8000
