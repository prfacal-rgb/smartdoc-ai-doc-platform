{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "console": {
      "format": "[%(asctime)s %(levelname)s] %(name)s: %(message)s",
      "datefmt": "%H:%M:%S"
    },
    "json": {
      "()": "app.logging_config.JsonFormatter"
    }
  },
  "handlers": {
    "console": {
      "class": "logging.StreamHandler",
      "formatter": "console",
      "stream": "ext://sys.stdout"
    },
    "file": {
      "class": "logging.handlers.TimedRotatingFileHandler",
      "formatter": "json",
      "filename": "logs/ai-service.log",
      "when": "midnight",
      "backupCount": 14,
      "encoding": "utf-8"
    }
  },
  "root": {
    "level": "INFO",
    "handlers": ["console", "file"]
  },
  "loggers": {
    "uvicorn": { "level": "INFO", "handlers": ["console", "file"], "propagate": false },
    "uvicorn.access": { "level": "INFO", "handlers": ["console", "file"], "propagate": false },
    "uvicorn.error": { "level": "INFO", "handlers": ["console", "file"], "propagate": false }
  }
}
