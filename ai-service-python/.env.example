# Copiar a ai-service-python/.env para correr pytest/uvicorn directo (fuera de Docker).
# Dentro de docker-compose, estas variables ya vienen del .env de la raíz del repo — este
# archivo es solo para desarrollo local del servicio Python de forma aislada.

EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://192.168.56.1:11434/v1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
